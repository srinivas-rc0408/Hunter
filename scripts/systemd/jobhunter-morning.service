[Unit]
OnFailure=jobhunter-alert@%n.service
Description=JobHunter morning brief (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/jobhunter
ExecStartPre=-%h/jobhunter/.venv/bin/hunt sync
ExecStart=%h/jobhunter/.venv/bin/hunt morning --send
