# Copy to .env (laptop). On GitHub, add the same names as repository secrets.
# Nothing here is required; each one switches a feature on.

# ── Telegram alerts (instant, free) ──────────────────────────────
# 1. In Telegram, open @BotFather → /newbot → copy the token below
# 2. Send your new bot any message, then run: hunt telegram-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Daily email digest (Gmail) ───────────────────────────────────
# Google Account → Security → 2-Step Verification → App passwords → "Mail"
SMTP_USER=
SMTP_PASS=
DIGEST_TO=

# ── Optional LLM for cover letters (works without it) ────────────
# auto (default): local Ollama if running → Gemini free tier → Groq free tier → plain templates.
# Works the same after any subscription ends. Free keys: aistudio.google.com · console.groq.com
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
# Models are checked against each provider's live list (retired IDs get swapped automatically).
# Optional overrides: OLLAMA_MODEL=qwen2.5:7b  GEMINI_MODEL=gemini-3.6-flash  GROQ_MODEL=openai/gpt-oss-120b
# Pin one provider instead of auto: LLM_PROVIDER=ollama|gemini|groq|openai|none (+ LLM_MODEL, LLM_API_KEY, LLM_BASE_URL)

# Encrypts the cloud radar's job database (created by `hunt secrets`)
STATE_KEY=

# Where `hunt backup` writes (default ~/jobhunter-backups)
# JOBHUNTER_BACKUP_DIR=
