# Copy to .env (laptop). On GitHub, add the same names as repository secrets.
# Nothing here is required; each one switches a feature on.

# ── Telegram alerts (instant, free) ──────────────────────────────
# 1. In Telegram, open @BotFather → /newbot → copy the token below
# 2. Send your new bot any message, then run: hunt telegram-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Daily email digest (Gmail) ───────────────────────────────────
# Google Account → Security → 2-Step Verification → App passwords → "Mail"
SMTP_USER=
SMTP_PASS=
DIGEST_TO=

# ── Optional LLM for cover letters + resume rewording (works without it) ──
# auto (default) tries, in order: NVIDIA build → local Ollama → Gemini → Groq → plain templates.
# A bad/rate-limited key, a retired model or a timeout just moves on to the next one.
# NVIDIA build: build.nvidia.com → sign in → API Keys → Generate. Several keys, comma-separated:
LLM_PROVIDER=auto
NVIDIA_API_KEYS=
# Local, no key, no quota: ./scripts/install-local-llm.sh  (sets OLLAMA_MODEL; qwen3:4b fits a 4 GB GPU)
OLLAMA_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
# Models are checked against each provider's live list (retired IDs get swapped automatically).
# Optional overrides: NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash  GEMINI_MODEL=gemini-3.6-flash  GROQ_MODEL=openai/gpt-oss-120b
# Pin one provider instead of auto: LLM_PROVIDER=nvidia|ollama|gemini|groq|openai|none (+ LLM_MODEL, LLM_API_KEY, LLM_BASE_URL)
# Check it all: hunt llm --test

# Encrypts the cloud radar's job database (created by `hunt secrets`)
STATE_KEY=

# Where `hunt backup` writes (default ~/jobhunter-backups)
# JOBHUNTER_BACKUP_DIR=

# ── Reading replies to your applications (hunt mail; every 30 min with sync) ──
# Read-only: sorts them with Gmail labels, updates statuses, never sends/deletes/marks read.
# Google Account → Security → 2-Step Verification → App passwords → create "JobHunter".
GMAIL_USER=
GMAIL_APP_PASSWORD=
